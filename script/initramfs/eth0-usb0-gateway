BB=/usr/bin/busybox
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
export PATH

INGRESS_IFACE=${THRURNDIS_VZNAT_IFACE:-eth0}
RNDIS_IFACE=${THRURNDIS_RNDIS_IFACE:-usb0}
TABLE_ID=${THRURNDIS_RNDIS_ROUTE_TABLE:-100}
RULE_PRIORITY=${THRURNDIS_RNDIS_ROUTE_PRIORITY:-1000}
RNDIS_WAIT_SECONDS=${THRURNDIS_RNDIS_WAIT_SECONDS:-2}
RNDIS_DHCP_ATTEMPTS=${THRURNDIS_RNDIS_DHCP_ATTEMPTS:-2}
RNDIS_DHCP_TIMEOUT_SECONDS=${THRURNDIS_RNDIS_DHCP_TIMEOUT_SECONDS:-2}
RNDIS_DHCP_TOTAL_TIMEOUT_SECONDS=${THRURNDIS_RNDIS_DHCP_TOTAL_TIMEOUT_SECONDS:-6}
NFT_TABLE=${THRURNDIS_NFT_TABLE:-thrurndis}
RNDIS_RESOLV_CONF=${THRURNDIS_RNDIS_RESOLV_CONF:-/etc/resolv.conf}
HOST_LINK_GUEST_IPV4=192.168.100.1
HOST_LINK_GUEST_CIDR=192.168.100.1/24
HOST_LINK_HOST_IPV4=192.168.100.2
HOST_LINK_HOST_CIDR=192.168.100.2/32
PORT_FORWARDING_MODULE=/usr/local/libexec/thrurndis/port-forwarding
MDNS_ADVERTISING_MODULE=/usr/local/libexec/thrurndis/mdns-advertising

log() {
    echo "thrurndis-gateway: $*" >/dev/kmsg 2>/dev/null || true
}

log_console() {
    log "$*"
    if [ -c /dev/console ]; then
        echo "thrurndis-gateway: $*" >/dev/console 2>/dev/null || true
    else
        echo "thrurndis-gateway: $*" >&2
    fi
}

if [ ! -r "$PORT_FORWARDING_MODULE" ]; then
    log_console "missing port forwarding module $PORT_FORWARDING_MODULE"
    exit 1
fi
# shellcheck source=/usr/local/libexec/thrurndis/port-forwarding
. "$PORT_FORWARDING_MODULE"
if [ ! -r "$MDNS_ADVERTISING_MODULE" ]; then
    log_console "missing mDNS advertising module $MDNS_ADVERTISING_MODULE"
    exit 1
fi
# shellcheck source=/usr/local/libexec/thrurndis/mdns-advertising
. "$MDNS_ADVERTISING_MODULE"

announce_route_ready() {
    log_console "THRURNDIS_RNDIS_ROUTE_READY=$1"
}

announce_rndis_ipv4() {
    log_console "THRURNDIS_RNDIS_IPV4=${1:-}"
}

run_with_timeout() {
    timeout_seconds=$1
    shift

    "$@" &
    child_pid=$!
    (
        $BB sleep "$timeout_seconds"
        kill "$child_pid" 2>/dev/null || true
        $BB sleep 1
        kill -9 "$child_pid" 2>/dev/null || true
    ) &
    watchdog_pid=$!

    wait "$child_pid"
    rc=$?
    kill "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true

    case "$rc" in
        137|143) return 124 ;;
        *) return "$rc" ;;
    esac
}

load_module() {
    module=$1
    timeout_seconds=${2:-4}
    [ -n "$module" ] || return 0

    run_with_timeout "$timeout_seconds" /sbin/modprobe -q "$module" 2>/tmp/modprobe.err
    rc=$?
    if [ "$rc" -eq 0 ]; then
        log_console "loaded module $module"
        return 0
    fi

    error=$($BB cat /tmp/modprobe.err 2>/dev/null || true)
    log_console "failed to load module $module rc=$rc ${error}"
    return "$rc"
}

wait_for_interface() {
    iface=$1
    timeout_seconds=${2:-2}
    elapsed=0

    while [ "$elapsed" -lt "$timeout_seconds" ]; do
        [ -e "/sys/class/net/$iface" ] && return 0
        [ -x /sbin/mdev ] && /sbin/mdev -s 2>/dev/null || true
        $BB sleep 1
        elapsed=$((elapsed + 1))
    done

    return 1
}

interface_ipv4_cidr() {
    iface=$1
    ip -4 -o addr show dev "$iface" scope global 2>/dev/null |
        $BB awk '{ print $4 }' | $BB head -n 1
}

canonical_ipv4() {
    value=$1
    printf '%s\n' "$value" | "$BB" awk 'NR == 1 {
        value = $0
        if (value !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
            exit 1
        }
        if (split(value, octets, /\./) != 4) {
            exit 1
        }
        for (i = 1; i <= 4; i++) {
            if ((octets[i] != "0" && octets[i] ~ /^0/) || octets[i] + 0 > 255) {
                exit 1
            }
        }
        print value
        next
    }
    { exit 1 }'
}

usable_unicast_ipv4() {
    value=$(canonical_ipv4 "$1") || return 1
    "$BB" awk -v value="$value" 'BEGIN {
        split(value, octets, /\./)
        if (octets[1] == 0 || octets[1] == 127 || octets[1] >= 224) {
            exit 1
        }
        print value
    }'
}

ipv4_route_is_unicast() {
    expected_ipv4=$1
    expected_iface=${2:-}

    "$BB" awk -v expected_ipv4="$expected_ipv4" \
        -v expected_iface="$expected_iface" '
        NR == 1 {
            destination_matches = $1 == expected_ipv4
            interface_matches = expected_iface == ""
            route_is_usable = 1
            for (i = 1; i <= NF; i++) {
                if ($i == "dev" && i < NF && $(i + 1) == expected_iface) {
                    interface_matches = 1
                }
                if ($i == "linkdown" || $i == "dead") {
                    route_is_usable = 0
                }
            }
        }
        END {
            exit(destination_matches && interface_matches && route_is_usable ? 0 : 1)
        }
    '
}

interface_ipv4_address() {
    iface=$1
    cidr=$(interface_ipv4_cidr "$iface")
    [ -n "$cidr" ] || return 1
    canonical_ipv4 "${cidr%%/*}"
}

interface_has_carrier() {
    iface=$1
    carrier=$("$BB" cat "/sys/class/net/$iface/carrier" 2>/dev/null || true)
    [ "$carrier" = 1 ]
}

interface_has_ipv4_cidr() {
    iface=$1
    expected_cidr=$2

    ip -4 -o addr show dev "$iface" scope global 2>/dev/null | $BB awk \
        -v expected_cidr="$expected_cidr" '
        $4 == expected_cidr { found = 1 }
        END { exit(found ? 0 : 1) }
    '
}

interface_default_gateway() {
    iface=$1
    ip -4 route show default dev "$iface" 2>/dev/null | $BB awk '
        $1 == "default" {
            for (i = 1; i <= NF; i++) {
                if ($i == "via" && i < NF) {
                    print $(i + 1)
                    exit
                }
            }
        }
    '
}

rndis_dns_server() {
    [ -f "$RNDIS_RESOLV_CONF" ] || return 1
    interface_has_carrier "$RNDIS_IFACE" || return 1
    rndis_source=$(interface_ipv4_address "$RNDIS_IFACE" || true)
    [ -n "$rndis_source" ] || return 1

    while IFS= read -r resolver_line || [ -n "$resolver_line" ]; do
        server=$(printf '%s\n' "$resolver_line" |
            "$BB" awk '$1 == "nameserver" { print $2; exit }')
        [ -n "$server" ] || continue
        server=$(usable_unicast_ipv4 "$server" || true)
        [ -n "$server" ] || continue

        main_route=$(ip -4 route get "$server" 2>/dev/null) || continue
        if ! printf '%s\n' "$main_route" |
            ipv4_route_is_unicast "$server"; then
            continue
        fi

        rndis_route=$(
            ip -4 route get "$server" from "$rndis_source" \
                oif "$RNDIS_IFACE" 2>/dev/null
        ) || continue
        if ! printf '%s\n' "$rndis_route" |
            ipv4_route_is_unicast "$server" "$RNDIS_IFACE"; then
            continue
        fi
        interface_has_carrier "$RNDIS_IFACE" || continue

        printf '%s' "$server"
        return 0
    done <"$RNDIS_RESOLV_CONF"

    return 1
}

configure_rndis_ipv4() {
    iface=$1
    udhcpc_log="/tmp/udhcpc-$iface.log"
    udhcpc_script=""

    if ! wait_for_interface "$iface" "$RNDIS_WAIT_SECONDS"; then
        log_console "$iface not found; skipping IPv4 DHCP"
        return 1
    fi

    log_console "requesting IPv4 DHCP on RNDIS interface $iface"
    ip link set dev "$iface" up 2>/dev/null || $BB ifconfig "$iface" up 2>/dev/null || true
    : >"$RNDIS_RESOLV_CONF"

    if [ -f /usr/share/udhcpc/default.script ]; then
        udhcpc_script="-s /usr/share/udhcpc/default.script"
    fi

    run_with_timeout "$RNDIS_DHCP_TOTAL_TIMEOUT_SECONDS" \
        udhcpc -i "$iface" -q -n -t "$RNDIS_DHCP_ATTEMPTS" \
        -T "$RNDIS_DHCP_TIMEOUT_SECONDS" $udhcpc_script >"$udhcpc_log" 2>&1
    rc=$?
    if [ "$rc" -eq 0 ]; then
        ipv4=$(interface_ipv4_address "$iface" || true)
        dns_server=$(rndis_dns_server || true)
        if [ -n "$ipv4" ] && [ -n "$dns_server" ]; then
            log_console "RNDIS interface $iface IPv4 $ipv4, DNS $dns_server"
            return 0
        fi

        log_console "RNDIS interface $iface DHCP completed without an IPv4 address and DNS server"
        return 1
    fi

    output=$($BB tail -n 3 "$udhcpc_log" 2>/dev/null | $BB tr '\n' ' ' || true)
    log_console "RNDIS interface $iface DHCP failed rc=$rc ${output}"
    return 1
}

load_netfilter_modules() {
    for module in nfnetlink nf_tables nf_conntrack nf_nat nft_chain_nat nft_ct nft_nat nft_masq; do
        load_module "$module" 2 || true
    done
}

ensure_rndis_gateway() {
    iface=${1:-$RNDIS_IFACE}

    if ! wait_for_interface "$iface" "$RNDIS_WAIT_SECONDS"; then
        log_console "RNDIS interface $iface is not present"
        return 1
    fi

    ip link set dev "$iface" up 2>/dev/null || $BB ifconfig "$iface" up 2>/dev/null || true

    ipv4=$(interface_ipv4_address "$iface" || true)
    gateway=$(interface_default_gateway "$iface")
    dns_server=$(rndis_dns_server || true)
    if [ -z "$ipv4" ] || [ -z "$gateway" ] || [ -z "$dns_server" ]; then
        configure_rndis_ipv4 "$iface" || return 1
    fi

    gateway=$(interface_default_gateway "$iface")
    if [ -z "$gateway" ]; then
        log_console "RNDIS interface $iface has no default gateway"
        return 1
    fi
    if ! rndis_dns_server >/dev/null; then
        log_console "RNDIS interface $iface has no DHCP DNS server"
        return 1
    fi

    printf '%s' "$gateway"
    return 0
}

enable_ipv4_forwarding() {
    if [ -w /proc/sys/net/ipv4/ip_forward ]; then
        echo 1 >/proc/sys/net/ipv4/ip_forward 2>/dev/null || true
    fi
    for filter in all "$INGRESS_IFACE" "$RNDIS_IFACE"; do
        path="/proc/sys/net/ipv4/conf/$filter/rp_filter"
        [ -w "$path" ] && echo 0 >"$path" 2>/dev/null || true
    done

    ip_forward=$($BB cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
    if [ "$ip_forward" != "1" ]; then
        log_console "IPv4 forwarding is not enabled; host-link-to-RNDIS routing may fail"
        return 1
    fi

    return 0
}

delete_policy_rule() {
    while ip rule delete priority "$RULE_PRIORITY" table "$TABLE_ID" 2>/dev/null; do
        :
    done
}

has_ingress_policy_rule() {
    expected_source=$1
    ip rule show 2>/dev/null | $BB awk \
        -v expected_source="$expected_source" \
        -v expected_interface="$INGRESS_IFACE" \
        -v expected_table="$TABLE_ID" '
        {
            source_matches = 0
            interface_matches = 0
            table_matches = 0
            for (i = 1; i <= NF; i++) {
                if ($i == "from" && i < NF) {
                    source = $(i + 1)
                    sub(/\/32$/, "", source)
                    source_matches = source == expected_source
                } else if ($i == "iif" && i < NF) {
                    interface_matches = $(i + 1) == expected_interface
                } else if ($i == "lookup" && i < NF) {
                    table_matches = $(i + 1) == expected_table
                }
            }
            if (source_matches && interface_matches && table_matches) {
                found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    '
}

install_policy_route() {
    rndis_gateway=$1

    if ! ip route replace "$rndis_gateway/32" dev "$RNDIS_IFACE" scope link table "$TABLE_ID" \
        2>/tmp/thrurndis-policy-link-route.err; then
        output=$($BB cat /tmp/thrurndis-policy-link-route.err 2>/dev/null || true)
        log_console "failed to install RNDIS gateway link route for $rndis_gateway: ${output}"
        return 1
    fi

    if ! ip route replace default via "$rndis_gateway" dev "$RNDIS_IFACE" table "$TABLE_ID" \
        2>/tmp/thrurndis-policy-route.err; then
        output=$($BB cat /tmp/thrurndis-policy-route.err 2>/dev/null || true)
        log_console "failed to install host-link ingress default route via $RNDIS_IFACE: ${output}"
        return 1
    fi

    delete_policy_rule
    if ip rule add priority "$RULE_PRIORITY" from "$HOST_LINK_HOST_CIDR" \
        iif "$INGRESS_IFACE" table "$TABLE_ID" \
        2>/tmp/thrurndis-policy-rule.err; then
        ip route flush cache 2>/dev/null || true
        log_console "configured ingress policy route: from $HOST_LINK_HOST_CIDR iif $INGRESS_IFACE lookup $TABLE_ID via $rndis_gateway dev $RNDIS_IFACE"
        return 0
    fi

    output=$($BB cat /tmp/thrurndis-policy-rule.err 2>/dev/null || true)
    log_console "failed to install ingress policy rule for $HOST_LINK_HOST_CIDR on $INGRESS_IFACE: ${output}"
    return 1
}

install_nftables() {
    rndis_dns=$1

    if ! thrurndis_pf_prepare_nft_rules; then
        log_console "refusing to install nftables with invalid port forwarding boot configuration"
        thrurndis_pf_announce_error_state invalid-state || true
        return 1
    fi

    if ! command -v nft >/dev/null 2>&1; then
        log_console "nft not found; skipping host-link-to-RNDIS masquerade"
        if [ "$THRURNDIS_PF_ENABLED" -eq 1 ]; then
            thrurndis_pf_announce_error_state nft-unavailable || true
        fi
        return 1
    fi

    load_netfilter_modules

    nft delete table ip "$NFT_TABLE" 2>/dev/null || true
    if nft -f - <<EOF_NFT
table ip $NFT_TABLE {
    $THRURNDIS_PF_SET_DEFINITION

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "$RNDIS_IFACE" ip daddr 224.0.0.251 udp dport 5353 return
        $THRURNDIS_PF_PREROUTING_RULES
        ip saddr $HOST_LINK_HOST_CIDR iifname "$INGRESS_IFACE" ip daddr $HOST_LINK_GUEST_IPV4 udp dport 53 dnat to $rndis_dns
        ip saddr $HOST_LINK_HOST_CIDR iifname "$INGRESS_IFACE" ip daddr $HOST_LINK_GUEST_IPV4 tcp dport 53 dnat to $rndis_dns
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        $THRURNDIS_PF_FORWARD_RULES
        ip saddr $HOST_LINK_HOST_CIDR iifname "$INGRESS_IFACE" oifname "$RNDIS_IFACE" accept
        ip daddr $HOST_LINK_HOST_CIDR iifname "$RNDIS_IFACE" oifname "$INGRESS_IFACE" ct state established,related accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        $THRURNDIS_PF_POSTROUTING_RULES
        ip saddr $HOST_LINK_HOST_CIDR iifname "$INGRESS_IFACE" oifname "$RNDIS_IFACE" masquerade
    }
}
EOF_NFT
    then
        if ! thrurndis_pf_rules_ready >/tmp/thrurndis-pf-rules.err 2>&1; then
            output=$($BB tail -n 8 /tmp/thrurndis-pf-rules.err 2>/dev/null | $BB tr '\n' ' ' || true)
            log_console "TCP and UDP port forwarding rule status is incomplete after nftables setup: ${output}"
            if [ "$THRURNDIS_PF_ENABLED" -eq 1 ]; then
                thrurndis_pf_announce_error_state rule-status || true
            fi
            return 1
        fi
        log_console "configured nftables host-link-to-RNDIS masquerade and DNS proxy: $HOST_LINK_HOST_CIDR on $INGRESS_IFACE, $HOST_LINK_GUEST_IPV4:53 -> $rndis_dns:53 on $RNDIS_IFACE"
        if [ "$THRURNDIS_PF_ENABLED" -eq 1 ]; then
            log_console "configured TCP and UDP port forwarding without port translation: $THRURNDIS_PF_PORTS"
        fi
        return 0
    fi

    log_console "failed to configure nftables host-link-to-RNDIS masquerade"
    if [ "$THRURNDIS_PF_ENABLED" -eq 1 ]; then
        thrurndis_pf_announce_error_state nft-install || true
    fi
    return 1
}

clear_gateway_state() {
    delete_policy_rule
    ip route flush table "$TABLE_ID" 2>/dev/null || true
    ip route flush cache 2>/dev/null || true

    if [ -w /proc/sys/net/ipv4/ip_forward ]; then
        echo 0 >/proc/sys/net/ipv4/ip_forward 2>/dev/null || true
    fi

    if command -v nft >/dev/null 2>&1; then
        nft delete table ip "$NFT_TABLE" 2>/dev/null || true
    fi
}

gateway_up() {
    # Withdraw host /1 routes while state is being rebuilt. A later =1 marker
    # is emitted only after the policy route, forwarding, and NAT all succeed.
    announce_route_ready 0
    announce_rndis_ipv4 ""
    thrurndis_pf_announce_pending_state || true
    clear_gateway_state

    if ! wait_for_interface "$INGRESS_IFACE" 1; then
        log_console "VZNAT interface $INGRESS_IFACE not found"
        clear_gateway_state
        return 1
    fi

    if ! interface_has_ipv4_cidr "$INGRESS_IFACE" "$HOST_LINK_GUEST_CIDR"; then
        log_console "VZNAT interface $INGRESS_IFACE does not have host link $HOST_LINK_GUEST_CIDR"
        clear_gateway_state
        return 1
    fi

    rndis_gateway=$(ensure_rndis_gateway "$RNDIS_IFACE") || {
        clear_gateway_state
        return 1
    }
    rndis_dns=$(rndis_dns_server || true)
    if [ -z "$rndis_dns" ]; then
        log_console "RNDIS DHCP did not provide an IPv4 DNS server"
        clear_gateway_state
        return 1
    fi

    if ! enable_ipv4_forwarding \
        || ! install_policy_route "$rndis_gateway" \
        || ! install_nftables "$rndis_dns"; then
        clear_gateway_state
        return 1
    fi
    rndis_ipv4=$(interface_ipv4_address "$RNDIS_IFACE" || true)
    if [ -z "$rndis_ipv4" ]; then
        log_console "RNDIS interface $RNDIS_IFACE has no canonical IPv4 address after setup"
        clear_gateway_state
        return 1
    fi
    if ! thrurndis_mdns_wait_ready "$rndis_ipv4"; then
        if [ "$THRURNDIS_PF_ENABLED" -eq 1 ]; then
            thrurndis_pf_announce_error_state mdns-unready || true
        fi
        clear_gateway_state
        return 1
    fi

    if ! gateway_status >/tmp/thrurndis-gateway-status.err 2>&1; then
        if [ "$THRURNDIS_PF_ENABLED" -eq 1 ] \
            && ! thrurndis_pf_rules_ready >>/tmp/thrurndis-gateway-status.err 2>&1; then
            thrurndis_pf_announce_error_state rule-status || true
        fi
        output=$($BB tail -n 8 /tmp/thrurndis-gateway-status.err 2>/dev/null | $BB tr '\n' ' ' || true)
        log_console "gateway status is incomplete after setup: ${output}"
        clear_gateway_state
        return 1
    fi

    log_console "gateway ready: host $HOST_LINK_HOST_CIDR -> $HOST_LINK_GUEST_CIDR on $INGRESS_IFACE -> $RNDIS_IFACE via $rndis_gateway, DNS $HOST_LINK_GUEST_IPV4:53 -> $rndis_dns:53"
    announce_rndis_ipv4 "$rndis_ipv4"
    announce_route_ready 1
    thrurndis_pf_announce_active_state || true
    return 0
}

gateway_down() {
    clear_gateway_state
    : >"$RNDIS_RESOLV_CONF"
    log_console "cleared host-link-to-RNDIS gateway state for $INGRESS_IFACE -> $RNDIS_IFACE"
    announce_route_ready 0
    announce_rndis_ipv4 ""
    thrurndis_pf_announce_pending_state || true
    return 0
}

gateway_status() {
    missing=0

    if ! interface_has_ipv4_cidr "$INGRESS_IFACE" "$HOST_LINK_GUEST_CIDR"; then
        echo "$INGRESS_IFACE does not have host link $HOST_LINK_GUEST_CIDR"
        missing=1
    fi

    if [ ! -e "/sys/class/net/$RNDIS_IFACE" ]; then
        echo "missing $RNDIS_IFACE"
        return 1
    fi

    ipv4=$(interface_ipv4_address "$RNDIS_IFACE" || true)
    rndis_gateway=$(interface_default_gateway "$RNDIS_IFACE")
    rndis_dns=$(rndis_dns_server || true)
    if [ -z "$ipv4" ]; then
        echo "$RNDIS_IFACE has no canonical IPv4 address"
        missing=1
    fi
    if [ -z "$rndis_gateway" ]; then
        echo "$RNDIS_IFACE has no default gateway"
        missing=1
    fi
    if [ -z "$rndis_dns" ]; then
        echo "$RNDIS_IFACE has no DHCP DNS server"
        missing=1
    fi

    if ! ip route show table "$TABLE_ID" default 2>/dev/null |
        $BB grep -F "dev $RNDIS_IFACE" >/dev/null 2>&1; then
        echo "missing policy route table $TABLE_ID default via $RNDIS_IFACE"
        missing=1
    fi
    if [ -n "$rndis_gateway" ] && ! ip route show table "$TABLE_ID" "$rndis_gateway/32" 2>/dev/null |
        $BB grep -F "dev $RNDIS_IFACE" >/dev/null 2>&1; then
        echo "missing policy link route to RNDIS gateway $rndis_gateway"
        missing=1
    fi

    if ! has_ingress_policy_rule "$HOST_LINK_HOST_IPV4"; then
        echo "missing ingress policy rule for host $HOST_LINK_HOST_CIDR on $INGRESS_IFACE lookup $TABLE_ID"
        missing=1
    fi

    ip_forward=$($BB cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
    if [ "$ip_forward" != "1" ]; then
        echo "IPv4 forwarding is disabled"
        missing=1
    fi

    if ! command -v nft >/dev/null 2>&1; then
        echo "nft not found"
        missing=1
    elif ! nft list table ip "$NFT_TABLE" >/dev/null 2>&1; then
        echo "missing nft table ip $NFT_TABLE"
        missing=1
    else
        if ! nft list chain ip "$NFT_TABLE" prerouting 2>/dev/null |
            $BB grep -F "iifname \"$RNDIS_IFACE\"" |
            $BB grep -F "ip daddr 224.0.0.251" |
            $BB grep -F "udp dport 5353" |
            $BB grep -F "return" >/dev/null 2>&1; then
            echo "missing local mDNS exemption on $RNDIS_IFACE"
            missing=1
        fi
        if [ -n "$rndis_dns" ]; then
            if ! nft list chain ip "$NFT_TABLE" prerouting 2>/dev/null |
                $BB grep -F "ip saddr $HOST_LINK_HOST_IPV4" |
                $BB grep -F "iifname \"$INGRESS_IFACE\"" |
                $BB grep -F "ip daddr $HOST_LINK_GUEST_IPV4" |
                $BB grep -F "udp dport 53" |
                $BB grep -F "dnat to $rndis_dns" >/dev/null 2>&1; then
                echo "missing UDP DNS proxy $HOST_LINK_GUEST_IPV4:53 -> $rndis_dns:53"
                missing=1
            fi
            if ! nft list chain ip "$NFT_TABLE" prerouting 2>/dev/null |
                $BB grep -F "ip saddr $HOST_LINK_HOST_IPV4" |
                $BB grep -F "iifname \"$INGRESS_IFACE\"" |
                $BB grep -F "ip daddr $HOST_LINK_GUEST_IPV4" |
                $BB grep -F "tcp dport 53" |
                $BB grep -F "dnat to $rndis_dns" >/dev/null 2>&1; then
                echo "missing TCP DNS proxy $HOST_LINK_GUEST_IPV4:53 -> $rndis_dns:53"
                missing=1
            fi
        fi
        if ! nft list chain ip "$NFT_TABLE" forward 2>/dev/null |
            $BB grep -F "ip saddr $HOST_LINK_HOST_IPV4" |
            $BB grep -F "iifname \"$INGRESS_IFACE\" oifname \"$RNDIS_IFACE\"" >/dev/null 2>&1; then
            echo "missing nft forward allowlist for host $HOST_LINK_HOST_CIDR"
            missing=1
        fi
        if ! nft list chain ip "$NFT_TABLE" forward 2>/dev/null |
            $BB grep -F "ip daddr $HOST_LINK_HOST_IPV4" |
            $BB grep -F "iifname \"$RNDIS_IFACE\" oifname \"$INGRESS_IFACE\"" |
            $BB grep -F "ct state established,related" >/dev/null 2>&1; then
            echo "missing nft return allowlist for host $HOST_LINK_HOST_CIDR"
            missing=1
        fi
        if ! nft list chain ip "$NFT_TABLE" postrouting 2>/dev/null |
            $BB grep -F "ip saddr $HOST_LINK_HOST_IPV4" |
            $BB grep -F "iifname \"$INGRESS_IFACE\" oifname \"$RNDIS_IFACE\"" >/dev/null 2>&1; then
            echo "missing nft masquerade allowlist for host $HOST_LINK_HOST_CIDR"
            missing=1
        fi
        if ! thrurndis_pf_rules_ready; then
            missing=1
        fi
    fi

    if ! thrurndis_pf_load_configuration; then
        echo "invalid port forwarding boot configuration for mDNS advertising"
        missing=1
    elif ! thrurndis_mdns_status "$ipv4"; then
        missing=1
    fi

    if [ "$missing" -eq 0 ]; then
        echo "ready host $HOST_LINK_HOST_CIDR -> $HOST_LINK_GUEST_CIDR on $INGRESS_IFACE -> $RNDIS_IFACE via $rndis_gateway table $TABLE_ID, DNS $HOST_LINK_GUEST_IPV4:53 -> $rndis_dns:53"
        return 0
    fi

    return 1
}

case "${1:-up}" in
    up)
        gateway_up
        ;;
    down)
        gateway_down
        ;;
    status)
        gateway_status
        ;;
    *)
        echo "usage: $0 {up|down|status}" >&2
        exit 2
        ;;
esac
