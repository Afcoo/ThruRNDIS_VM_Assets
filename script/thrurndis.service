SPDX-License-Identifier: GPL-2.0-or-later

Address discovery only: port zero does not advertise a listening TCP server.
Clients resolve this service, then use their separately configured host port.
-->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="no">ThruRNDIS</name>
  <service protocol="ipv4">
    <type>_thrurndis._tcp</type>
    <domain-name>local</domain-name>
    <host-name>thrurndis.local</host-name>
    <port>0</port>
    <txt-record>txtvers=1</txt-record>
    <txt-record>hostname=thrurndis.local</txt-record>
    <txt-record>discovery-only=1</txt-record>
  </service>
</service-group>
