# This file is updated only by script/update_dependencies.py.  The normal
# builder consumes these pinned values and config/packages.lock.json.
ALPINE_VERSION=3.24.2
ALPINE_BRANCH=v3.24
ALPINE_ARCH=aarch64
ALPINE_FLAVOR=standard
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
ALPINE_ISO_SHA256=e078b567b4b283b629f4b8659bccc477a060a5521c4d933ecf9591a1df8ba48f
ALPINE_APORTS_COMMIT=d9d560d5de74ff9a7a73f3c903d6f126a0bf3142

# Packages copied into the initramfs.  Their complete runtime dependency
# closure is recorded in packages.lock.json.
GUEST_ROOT_PACKAGES="busybox iproute2 nftables tcpdump"

# Kernel modules copied from the locked linux-lts APK.  A module built into
# the kernel satisfies a seed; otherwise its modules.dep closure is copied.
KERNEL_MODULES="virtio_pci virtio_mmio virtio_console virtio_net af_packet xhci_hcd xhci_pci usbnet cdc_ether cdc_subset rndis_host nfnetlink nf_tables nf_conntrack nf_nat nft_chain_nat nft_ct nft_nat nft_masq"
